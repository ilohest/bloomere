{% comment %}
  Shared background renderer. Uses an image_picker; no filename registry.
  Render inside .bloomere-background and use .bloomere-background__content
  for its content sibling. Pass section: section.
{% endcomment %}
{%- liquid
  assign pattern_image = section.settings.bloomere_pattern_image
  assign tile_width = section.settings.bloomere_tile_width | default: 240
-%}
{%- if pattern_image != blank -%}
  {%- assign source_width = tile_width | times: 2 | at_most: pattern_image.width -%}
  <style>
    #shopify-section-{{ section.id }} .bloomere-background {
      position: relative;
      isolation: isolate;
    }
    #shopify-section-{{ section.id }} .bloomere-background__pattern {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      border-radius: inherit;
      background-image: url({{ pattern_image | image_url: width: source_width | json }});
      background-repeat: repeat;
      background-position: center;
      background-size: {{ tile_width }}px auto;
    }
    #shopify-section-{{ section.id }} .bloomere-background__content {
      position: relative;
      z-index: 1;
    }
  </style>
  <div class="bloomere-background__pattern" aria-hidden="true"></div>
{%- endif -%}
