{%- liquid
  assign divider_color = settings.color_body_bg
  case section.settings.divider_palette
    when 'neutral'
      assign divider_color = settings.color_body_bg
    when 'light'
      assign divider_color = settings.color_bg_light
    when 'dark'
      assign divider_color = settings.color_bg_inverse
    when 'dark_accent'
      assign divider_color = settings.color_bg_accent_inverse
    when 'bright'
      assign divider_color = settings.color_bg_bright
    when 'bright_accent'
      assign divider_color = settings.color_bg_accent_bright
  endcase
  assign hero_height = '66.67svh'
  case section.settings.section_height
    when 'use_screen_full'
      assign hero_height = '100svh'
    when 'use_screen_three_quarters'
      assign hero_height = '75svh'
    when 'use_screen_one_half'
      assign hero_height = '50svh'
    when 'use_screen_one_third'
      assign hero_height = '33.33svh'
    when 'use_screen_one_fifth'
      assign hero_height = '20svh'
    when 'use_pixels_800'
      assign hero_height = '800px'
    when 'use_pixels_650'
      assign hero_height = '650px'
    when 'use_pixels_500'
      assign hero_height = '500px'
    when 'use_image'
      assign hero_height = 'auto'
  endcase
-%}
{{ 'bloomere-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bloomere-slideshow.js' | asset_url }}" defer></script>
<bloomere-hero class="bh bc flickity-badge-dots{% if section.settings.divider_enabled %} bc--divider{% endif %}{% if hero_height == 'auto' %} bc--image-height{% endif %}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_speed | times: 1000 }}" data-editor="{{ request.design_mode }}" role="region" aria-roledescription="carousel" aria-label="Featured stories"
 style="--bh-height: {{ hero_height }}; --bh-mobile: {{ section.settings.mobile_height }}px; --bc-divider-color: {{ divider_color }}; --bc-divider-desktop: {{ section.settings.divider_height }}px; --bc-divider-mobile: {{ section.settings.divider_height_mobile }}px;">
  <div class="bh__slides">
  {% for block in section.blocks %}
    {%- liquid
      assign count = block.settings.columns | plus: 0
      assign loading = 'lazy'
      assign priority = 'auto'
      if forloop.first and section.settings.priority
        assign loading = 'eager'
        assign priority = 'high'
      endif
      assign tracks = 'minmax(0, 1fr)'
      if count == 2
        assign tracks = block.settings.left_width | append: '% minmax(0, 1fr)'
      elsif count == 3
        case block.settings.thirds
          when 'left'
            assign tracks = 'minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr)'
          when 'center'
            assign tracks = 'minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr)'
          when 'right'
            assign tracks = 'minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr)'
          else
            assign tracks = 'repeat(3, minmax(0, 1fr))'
        endcase
      endif
    -%}
    <article class="bh__slide" data-bh-slide data-block-id="{{ block.id }}" id="bh-{{ section.id }}-{{ block.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ section.blocks.size }}" {{ block.shopify_attributes }} style="--bc-tracks: {{ tracks }};">
    {% for column in (1..count) %}
      {%- liquid
        assign prefix = 'c' | append: column | append: '_'
        assign key = prefix | append: 'background'
        assign background = block.settings[key]
        assign key = prefix | append: 'image'
        assign img = block.settings[key]
        assign mobile = img
        if block.settings.custom_mobile
          assign key = prefix | append: 'mobile'
          assign mobile = block.settings[key] | default: img
        endif
        assign key = prefix | append: 'palette'
        assign palette = block.settings[key]
        assign key = prefix | append: 'content'
        assign enabled = block.settings[key]
        assign key = prefix | append: 'eyebrow'
        assign eyebrow = block.settings[key]
        assign key = prefix | append: 'title'
        assign title = block.settings[key]
        assign key = prefix | append: 'text'
        assign text = block.settings[key]
        assign key = prefix | append: 'button_label'
        assign button_label = block.settings[key]
        assign key = prefix | append: 'button_url'
        assign button_url = block.settings[key]
        assign key = prefix | append: 'align'
        assign align = block.settings[key]
        assign key = prefix | append: 'vertical'
        assign vertical = block.settings[key]
        assign key = prefix | append: 'ink'
        assign ink = block.settings[key]
        assign key = prefix | append: 'button_color'
        assign button_color = block.settings[key] | default: 'btn--neutral'
        assign key = prefix | append: 'shade'
        assign shade = block.settings[key]
        assign has_button = false
        if button_label != blank and button_url != blank
          assign has_button = true
        endif
        assign has_content = false
        if enabled
          if eyebrow != blank or title != blank or text != blank or has_button
            assign has_content = true
          endif
        endif
      -%}
      <div class="bh__column {% if background == 'solid' %}bh__panel {{ palette }}{% else %}bh__media{% endif %}" style="--bc-ratio: {{ img.aspect_ratio | default: 1.5 }}; --bh-align: {{ align }}; --bh-vertical: {{ vertical }}; --bh-ink: {{ ink }}; --bh-shade: {{ shade | times: 0.01 }};">
        {% if background == 'image' %}
          <picture class="bh__picture" style="--bh-focal: {{ img.presentation.focal_point | default: '50% 50%' }}; --bh-focal-mobile: {{ mobile.presentation.focal_point | default: '50% 50%' }};">
            {% if block.settings.custom_mobile and mobile != blank %}<source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 900 }}">{% endif %}
            {% if img != blank %}
              {{ img | image_url: width: 2400 | image_tag: widths: '400, 600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: loading, fetchpriority: priority, class: 'bh__image' }}
            {% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'bh__placeholder' }}{% endif %}
          </picture>
          {%- assign priority = 'auto' -%}
          {% if has_content %}<div class="bh__shade" aria-hidden="true"></div>{% endif %}
        {% endif %}
        {% if has_content %}
          <div class="bh__content"><div class="bh__copy text-{{ align }}">
            {% if eyebrow != blank %}<p class="bh__eyebrow hero__kicker">{{ eyebrow | escape }}</p>{% endif %}
            {% if title != blank %}<h2 class="bh__title hero__title heading-size-9">{{ title | escape }}</h2>{% endif %}
            {% if text != blank %}<div class="bh__text hero__description rte body-size-6">{{ text }}</div>{% endif %}
            {% if has_button %}<div class="hero__cta__wrapper"><a class="{{ button_color }} {{ block.settings.button_style }} hero__btn btn--long" href="{{ button_url }}">{{ button_label | escape }}</a></div>{% endif %}
          </div></div>
        {% endif %}
      </div>
    {% endfor %}
    </article>
  {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <nav class="bh__navigation" aria-label="Slideshow controls" hidden>
      <div class="flickity-page-dots">
        {% if section.settings.autoplay %}<button type="button" class="bc__rotation" data-bh-toggle aria-label="Pause slideshow">Ⅱ</button>{% endif %}
        {% for block in section.blocks %}<button class="flickity-page-dot{% if forloop.first %} is-selected{% endif %}" type="button" data-bh-go="{{ forloop.index0 }}" aria-controls="bh-{{ section.id }}-{{ block.id }}" aria-label="Show slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}
      </div>
    </nav>
    <p class="bh__sr" data-bh-status aria-live="polite" aria-atomic="true"></p>
  {% endif %}
  {% if section.settings.divider_enabled %}
    <div class="bc__divider" aria-hidden="true">
      <svg class="bc__divider-desktop" viewBox="0 0 1440 100" preserveAspectRatio="none" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 60.8 Q24 59.5 36 59.83 Q48 60.15 58 57.23 Q68 54.3 81 52.67 Q94 51.05 106 49.1 Q118 47.15 130.5 46.5 Q143 45.85 155.5 47.48 Q168 49.1 180 47.8 Q192 46.5 204.5 47.48 Q217 48.45 229 46.83 Q241 45.2 253.5 45.53 Q266 45.85 277.5 44.23 Q289 42.6 301.5 43.58 Q314 44.55 326 43.25 Q338 41.95 350 42.92 Q362 43.9 375.5 45.2 Q389 46.5 401 45.85 Q413 45.2 426 46.17 Q439 47.15 451.5 46.5 Q464 45.85 475.5 47.48 Q487 49.1 498.5 50.4 Q510 51.7 522 53 Q534 54.3 546 53.33 Q558 52.35 569.5 53 Q581 53.65 592.5 52.02 Q604 50.4 616 49.42 Q628 48.45 639.5 46.83 Q651 45.2 663.5 43.9 Q676 42.6 688 42.92 Q700 43.25 711.5 41.3 Q723 39.35 735 39.03 Q747 38.7 758.5 36.42 Q770 34.15 782.5 32.85 Q795 31.55 807 29.6 Q819 27.65 831 27 Q843 26.35 855.5 24.73 Q868 23.1 880 23.42 Q892 23.75 904 22.45 Q916 21.15 928 21.48 Q940 21.8 952 20.82 Q964 19.85 976.5 20.17 Q989 20.5 1001 19.2 Q1013 17.9 1025 18.23 Q1037 18.55 1049.5 17.9 Q1062 17.25 1074 17.57 Q1086 17.9 1098 16.92 Q1110 15.95 1122 16.6 Q1134 17.25 1146 16.92 Q1158 16.6 1170.5 17.9 Q1183 19.2 1195 18.55 Q1207 17.9 1219 18.88 Q1231 19.85 1243 19.2 Q1255 18.55 1267.5 19.52 Q1280 20.5 1292 19.85 Q1304 19.2 1316 19.85 Q1328 20.5 1340 20.17 Q1352 19.85 1364 20.82 Q1376 21.8 1388 21.15 Q1400 20.5 1410 21.15 Q1420 21.8 1430 22.45 L1440 23.1 V100 H0 Z" fill="currentColor"/>
      </svg>
      <svg class="bc__divider-mobile" viewBox="0 0 480 100" preserveAspectRatio="none" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 52.35 Q20 51.05 29.5 48.77 Q39 46.5 48.5 47.48 Q58 48.45 67.5 46.83 Q77 45.2 86.5 46.17 Q96 47.15 105.5 48.45 Q115 49.75 124.5 49.1 Q134 48.45 143.5 50.4 Q153 52.35 162.5 53 Q172 53.65 181.5 52.35 Q191 51.05 200.5 48.77 Q210 46.5 219.5 45.85 Q229 45.2 238.5 42.28 Q248 39.35 257.5 37.4 Q267 35.45 276.5 32.85 Q286 30.25 295.5 29.27 Q305 28.3 314.5 26.02 Q324 23.75 333.5 24.73 Q343 25.7 352.5 23.75 Q362 21.8 371.5 22.77 Q381 23.75 390.5 22.45 Q400 21.15 409.5 22.77 Q419 24.4 428.5 23.42 Q438 22.45 448.5 24.07 Q459 25.7 469.5 25.05 L480 24.4 V100 H0 Z" fill="currentColor"/>
      </svg>
    </div>
  {% endif %}
</bloomere-hero>

{% schema %}
{
  "name": "Bloomere slideshow",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {"type": "header", "content": "Custom divider"},
    {"type": "checkbox", "id": "divider_enabled", "label": "Show bottom divider", "default": false},
    {"type": "select", "id": "divider_palette", "label": "Divider palette", "options": [{"value": "neutral", "label": "Default"}, {"value": "light", "label": "Light"}, {"value": "dark", "label": "Dark"}, {"value": "dark_accent", "label": "Dark accent"}, {"value": "bright", "label": "Bright"}, {"value": "bright_accent", "label": "Bright accent"}], "default": "neutral", "info": "Match the background palette of the next section for a seamless transition."},
    {"type": "range", "id": "divider_height", "label": "Desktop height", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 64},
    {"type": "range", "id": "divider_height_mobile", "label": "Mobile height", "min": 12, "max": 80, "step": 4, "unit": "px", "default": 32},

    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Change slides every",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "priority",
      "label": "Prioritize first image load",
      "default": false,
      "info": "Prioritize loading the first image of the slideshow before all other images on the page. Helpful when this section is first on a page, harmful when this section is below other image sections."
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section height",
      "default": "use_screen_two_thirds",
      "options": [
        {
          "value": "use_screen_full",
          "label": "Full screen height"
        },
        {
          "value": "use_screen_three_quarters",
          "label": "Three quarters of screen height"
        },
        {
          "value": "use_screen_two_thirds",
          "label": "Two thirds of screen height"
        },
        {
          "value": "use_screen_one_half",
          "label": "One half of screen height"
        },
        {
          "value": "use_screen_one_third",
          "label": "One third of screen height"
        },
        {
          "value": "use_screen_one_fifth",
          "label": "One fifth of screen height"
        },
        {
          "value": "use_pixels_800",
          "label": "800px"
        },
        {
          "value": "use_pixels_650",
          "label": "650px"
        },
        {
          "value": "use_pixels_500",
          "label": "500px"
        },
        {
          "value": "use_image",
          "label": "Image height"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile image height",
      "min": 240,
      "max": 600,
      "step": 20,
      "default": 360,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "select",
          "id": "columns",
          "label": "Number of columns",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "1 column"
            },
            {
              "value": "2",
              "label": "2 columns"
            },
            {
              "value": "3",
              "label": "3 columns"
            }
          ]
        },
        {
          "type": "range",
          "id": "left_width",
          "label": "Column 1 width",
          "min": 30,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 50,
          "visible_if": "{{ block.settings.columns == '2' }}"
        },
        {
          "type": "select",
          "id": "thirds",
          "label": "Three-column layout",
          "default": "equal",
          "options": [
            {
              "value": "equal",
              "label": "Equal widths"
            },
            {
              "value": "left",
              "label": "50 / 25 / 25"
            },
            {
              "value": "center",
              "label": "25 / 50 / 25"
            },
            {
              "value": "right",
              "label": "25 / 25 / 50"
            }
          ],
          "visible_if": "{{ block.settings.columns == '3' }}"
        },
        {
          "type": "checkbox",
          "id": "custom_mobile",
          "label": "Use different images on mobile",
          "default": false
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "btn",
          "options": [
            {
              "value": "btn",
              "label": "Solid button"
            },
            {
              "value": "btn--soft",
              "label": "Soft button"
            },
            {
              "value": "btn--outline",
              "label": "Outlined button"
            }
          ],
          "info": "Applies to all CTA buttons in this slide."
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "select",
          "id": "c1_background",
          "label": "Background",
          "default": "image",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "solid",
              "label": "Solid color"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "c1_image",
          "label": "Image",
          "visible_if": "{{ block.settings.c1_background == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "c1_mobile",
          "label": "Mobile image",
          "info": "Optional. Uses the main image when left empty.",
          "visible_if": "{{ block.settings.c1_background == 'image' and block.settings.custom_mobile }}"
        },
        {
          "type": "select",
          "id": "c1_palette",
          "label": "Background and text palette",
          "options": [
            {
              "value": "palette--light bg--neutral",
              "label": "Default"
            },
            {
              "value": "palette--light bg--accent",
              "label": "Light"
            },
            {
              "value": "palette--dark bg--invert",
              "label": "Dark"
            },
            {
              "value": "palette--dark bg--invert--accent",
              "label": "Dark accent"
            },
            {
              "value": "palette--bright bg--bright",
              "label": "Bright"
            },
            {
              "value": "palette--bright bg--bright--accent",
              "label": "Bright accent"
            }
          ],
          "default": "palette--light bg--neutral",
          "visible_if": "{{ block.settings.c1_background == 'solid' }}"
        },
        {
          "type": "checkbox",
          "id": "c1_content",
          "label": "Add text or a button",
          "default": true
        },
        {
          "type": "text",
          "id": "c1_eyebrow",
          "label": "Kicker",
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "text",
          "id": "c1_title",
          "label": "Heading",
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "richtext",
          "id": "c1_text",
          "label": "Text",
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "text",
          "id": "c1_button_label",
          "label": "Button label",
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "url",
          "id": "c1_button_url",
          "label": "Button link",
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "select",
          "id": "c1_button_color",
          "label": "Button color",
          "default": "btn--neutral",
          "options": [
            {
              "value": "btn--primary",
              "label": "Bright accent"
            },
            {
              "value": "btn--secondary",
              "label": "Secondary accent"
            },
            {
              "value": "btn--neutral",
              "label": "Text color"
            },
            {
              "value": "btn--black",
              "label": "Black"
            },
            {
              "value": "btn--white",
              "label": "White"
            }
          ],
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "select",
          "id": "c1_align",
          "label": "Horizontal alignment",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "select",
          "id": "c1_vertical",
          "label": "Vertical alignment",
          "default": "center",
          "options": [
            {
              "value": "start",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Middle"
            },
            {
              "value": "end",
              "label": "Bottom"
            }
          ],
          "visible_if": "{{ block.settings.c1_content }}"
        },
        {
          "type": "color",
          "id": "c1_ink",
          "label": "Text color over image",
          "default": "#ffffff",
          "visible_if": "{{ block.settings.c1_background == 'image' and block.settings.c1_content }}"
        },
        {
          "type": "range",
          "id": "c1_shade",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "default": 20,
          "visible_if": "{{ block.settings.c1_background == 'image' and block.settings.c1_content }}"
        },
        {
          "type": "header",
          "content": "Column 2",
          "visible_if": "{{ block.settings.columns != '1' }}"
        },
        {
          "type": "select",
          "id": "c2_background",
          "label": "Background",
          "default": "image",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "solid",
              "label": "Solid color"
            }
          ],
          "visible_if": "{{ block.settings.columns != '1' }}"
        },
        {
          "type": "image_picker",
          "id": "c2_image",
          "label": "Image",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_background == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "c2_mobile",
          "label": "Mobile image",
          "info": "Optional. Uses the main image when left empty.",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_background == 'image' and block.settings.custom_mobile }}"
        },
        {
          "type": "select",
          "id": "c2_palette",
          "label": "Background and text palette",
          "options": [
            {
              "value": "palette--light bg--neutral",
              "label": "Default"
            },
            {
              "value": "palette--light bg--accent",
              "label": "Light"
            },
            {
              "value": "palette--dark bg--invert",
              "label": "Dark"
            },
            {
              "value": "palette--dark bg--invert--accent",
              "label": "Dark accent"
            },
            {
              "value": "palette--bright bg--bright",
              "label": "Bright"
            },
            {
              "value": "palette--bright bg--bright--accent",
              "label": "Bright accent"
            }
          ],
          "default": "palette--light bg--neutral",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_background == 'solid' }}"
        },
        {
          "type": "checkbox",
          "id": "c2_content",
          "label": "Add text or a button",
          "default": false,
          "visible_if": "{{ block.settings.columns != '1' }}"
        },
        {
          "type": "text",
          "id": "c2_eyebrow",
          "label": "Kicker",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_content }}"
        },
        {
          "type": "text",
          "id": "c2_title",
          "label": "Heading",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_content }}"
        },
        {
          "type": "richtext",
          "id": "c2_text",
          "label": "Text",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_content }}"
        },
        {
          "type": "text",
          "id": "c2_button_label",
          "label": "Button label",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_content }}"
        },
        {
          "type": "url",
          "id": "c2_button_url",
          "label": "Button link",
          "visible_if": "{{ block.settings.columns != '1' and block.settings.c2_content }}"
        },
